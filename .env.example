# Configuración del central (CS-002 §9). Copiar a .env y completar; .env nunca entra
# al repositorio. Un valor vacío significa el valor por defecto.

# Token de /admin/... (D17). Vacío: administración deshabilitada (todo responde 403).
# Generar con:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# En la VM: publicar el 9000 solo en la máquina, para que a internet salga solo Caddy.
# En el portátil de respaldo: dejarlo vacío (9000 en todas las interfaces).
PUBLICAR=

# Nombre con el que Caddy pide el certificado (D09). Solo se usa con --profile nube.
DOMINIO=dsp.cshire.io

# true solo en el portátil de respaldo, donde los grupos están en la misma red (A2).
PERMITIR_URL_PRIVADAS=

# Valores por defecto de la especificación; normalmente no se tocan.
RUTA_BD=
PUERTO=
HEARTBEAT_INTERVALO_S=
HEARTBEAT_FALLOS_PARA_CAIDO=
BACKOFF_BASE_S=
BACKOFF_MAX_S=
HTTP_TIMEOUT_S=
MAX_SERVIDORES=
